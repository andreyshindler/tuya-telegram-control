# Copy to config.env and fill in the real values. config.env is gitignored.
#
# All four come from platform.tuya.com → Cloud → your project → Overview.
# The Access Secret is shown once; use "Reset Key" there if you lose or rotate it.

# Tuya Developer Platform Access ID (a.k.a. Client ID)
TUYA_ACCESS_ID=your_access_id_here
# Tuya Developer Platform Access Secret (a.k.a. Client Secret)
TUYA_ACCESS_SECRET=your_access_secret_here
# Tuya app account UID — Overview → Devices → Link App Account → the "UID" column
TUYA_UID=your_app_account_uid_here
# Data center endpoint. Central Europe = https://openapi.tuyaeu.com
# Others: US https://openapi.tuyaus.com | China https://openapi.tuyacn.com
# India https://openapi.tuyain.com | Western America https://openapi-ueaz.tuyaus.com
TUYA_ENDPOINT=https://openapi.tuyaeu.com

# --- Telegram bot (scripts/telegram_bot.py) ---------------------------------

# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated numeric Telegram user ids allowed to control your devices.
# The bot refuses to start while this is empty — an open bot means anyone who
# finds it can switch things on and off in your home. To find your id, start
# the bot with a placeholder id, send it /whoami, then put the real id here
# and restart.
TELEGRAM_ALLOWED_USERS=

# --- Hebrew voice + natural language ----------------------------------------
# Both are optional. Without ANTHROPIC_API_KEY the bot still answers the slash
# commands; without STT_* it still accepts free-text Hebrew, just not voice.

# Claude turns "תכבה את האור בסלון" into a device command.
ANTHROPIC_API_KEY=your_anthropic_key_here
# INTENT_MODEL=claude-opus-5

# Speech-to-text: any OpenAI-compatible /audio/transcriptions endpoint.
# These match the hebrew-voice project's HV_STT_* settings, and the HV_ names
# are also accepted, so existing values can be copied across unchanged.
STT_URL=https://api.groq.com/openai/v1
STT_KEY=your_stt_key_here
# STT_MODEL=whisper-large-v3
# STT_LANGUAGE=he
# STT_TIMEOUT=60

# --- Optional ---------------------------------------------------------------

# Optional: use a Schema instead of a UID (source_type=homeApp rather than tuyaUser).
# Only set this if TUYA_UID is left unset.
# TUYA_SCHEMA=

# --- Hebrew voice replies (ElevenLabs) --------------------------------------
# Optional. Without these, replies are text only.
# Verified: eleven_v3 speaks Hebrew; a short confirmation costs ~16 credits.
ELEVENLABS_API_KEY=your_elevenlabs_key_here
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
# ELEVENLABS_MODEL=eleven_v3
# auto (default) answers in the medium you used — speak to it and it speaks
# back, type and it types. always speaks every reply; never disables speech.
# VOICE_REPLIES=auto
